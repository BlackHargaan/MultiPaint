{
  "name": "multipaint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paint STL/3MF models for multicolor 3D printing and export a painted 3MF for Orca/Bambu.",
  "author": "MultiPaint",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:electron": "cross-env ELECTRON=1 vite build",
    "electron:dev": "electron .",
    "dist": "npm run build:electron && electron-builder",
    "dist:publish": "npm run build:electron && electron-builder --publish always"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.4",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.10"
  }
}
